<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>四字熟語占い</title>
    <style>
        body { font-family: sans-serif; text-align: center; background-color: #f0f0f0; padding: 20px; }
        .card { background: white; padding: 30px; border-radius: 15px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); max-width: 400px; margin: auto; }
        h1 { color: #333; }
        #result { font-size: 2rem; font-weight: bold; color: #d32f2f; margin: 20px 0; }
        button { background: #007bff; color: white; border: none; padding: 10px 20px; border-radius: 5px; font-size: 1rem; cursor: pointer; }
        button:hover { background: #0056b3; }
    </style>
</head>
<body>
    <div class="card">
        <h1>今日の四字熟語占い</h1>
        <p>あなたの今日の運勢は...</p>
        <div id="result">？？？？</div>
        <button onclick="fortune()">占う！</button>
    </div>

    <script>
        function fortune() {
            const list = ["一石二鳥", "笑門来福", "猪突猛進", "一生懸命", "一期一会", "勇気凛々", "意気揚々", "天真爛漫"];
            const random = list[Math.floor(Math.random() * list.length)];
            document.getElementById('result').innerText = random;
        }
    </script>
</body>
</html>
